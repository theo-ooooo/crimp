# Crimp 백엔드 API 베이스 URL.
# (PR-A1) react-native-config 도입 — `.env` 가 빌드 타임에 주입된다.
#
# 미설정 시 src/lib/api/config.ts 가 platform 기반 default 를 사용:
#   - Android 에뮬레이터 → http://10.0.2.2:8080 (호스트 Mac 의 localhost)
#   - iOS 시뮬레이터/그 외   → http://localhost:8080
# 실 디바이스 (LAN IP 또는 staging) 는 `CRIMP_API_URL` 명시 권장.
#
# 멀티 환경 — `.env` 외에 `.env.staging` / `.env.production` 등 파일을 만들고
# 빌드 시점에 ENVFILE 환경변수로 선택:
#   ENVFILE=.env.staging pnpm run android
#   ENVFILE=.env.staging pnpm run ios
#
# .env*.local 은 gitignore (.env, .env.* 모두 ignore, .env.example 만 추적).
# 변경 후엔 Metro 캐시 초기화: `pnpm start --reset-cache`.
CRIMP_API_URL=http://localhost:8080

# Kakao JavaScript Map key for WebView map previews.
# Register KAKAO_MAP_BASE_URL in Kakao Developers > Platform > Web.
# iOS WKWebView uses https for this origin so Kakao's internal scripts stay HTTPS.
KAKAO_MAP_JS_KEY=
KAKAO_MAP_BASE_URL=http://localhost:8081
