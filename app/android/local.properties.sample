# Crimp Android — local-only secrets (gitignored).
#
# 이 파일을 `local.properties` 로 복사하고 실제 값을 채운다.
# Android Studio 가 자동 생성하는 `sdk.dir` 도 같이 들어간다.
#
#   cp app/android/local.properties.sample app/android/local.properties
#   # 그 후 KAKAO_APP_KEY 채움
#
# Kakao 네이티브 앱 키 (콘솔 > 앱 > 앱 키 > 네이티브 앱 키).
# 비어있으면 카카오 로그인이 동작하지 않는다.
KAKAO_APP_KEY=

# Android Studio 가 자동으로 추가하는 SDK 경로 — IDE 가 직접 채워넣음.
# sdk.dir=/Users/<you>/Library/Android/sdk
