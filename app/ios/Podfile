def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

# Use it to require both react-native's and react-native-permissions' scripts:
node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!

# [PR #100, F5 PR-B] react-native-permissions 의 iOS 측 핵심: 본 setup_permissions 에 명시된
# 권한만 빌드에 포함된다. 카메라/마이크/위치(WhenInUse) — 그 외는 호출해도 unavailable 반환.
setup_permissions([
  'Camera',
  'Microphone',
  'LocationWhenInUse',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Crimp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'CrimpTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Crimp.xcconfig 의 KAKAO_APP_KEY 를 Cocoapods 가 생성하는 Pods-Crimp.{debug,release}.xcconfig
    # 파일에 직접 append 한다. Xcode UI 에서 Configuration File 을 수동 지정하지 않아도
    # main app target 이 Pods xcconfig 를 baseConfiguration 으로 쓰고 있어 자동 상속 →
    # `Info.plist` 의 `$(KAKAO_APP_KEY)` 가 정상 치환된다 (KOE101 / "잘못된 앱키" 회귀 방지).
    #
    # `Crimp.xcconfig` 가 없으면 (= 로컬 셋업 미완료) 키 주입 자체를 스킵하고 빌드 단계의
    # `validate-kakao-key.sh` 가 명시 에러로 실패시킨다.
    xcconfig_path = File.expand_path('Crimp.xcconfig', __dir__)
    if File.exist?(xcconfig_path)
      kakao_app_key = File.foreach(xcconfig_path).find { |l| l =~ /^\s*KAKAO_APP_KEY\s*=/ }
      kakao_app_key = kakao_app_key ? kakao_app_key.split('=', 2).last.strip : ''
      ['Pods-Crimp/Pods-Crimp.debug.xcconfig',
       'Pods-Crimp/Pods-Crimp.release.xcconfig',
       'Pods-Crimp-CrimpTests/Pods-Crimp-CrimpTests.debug.xcconfig',
       'Pods-Crimp-CrimpTests/Pods-Crimp-CrimpTests.release.xcconfig'].each do |rel|
        path = File.expand_path("Pods/Target Support Files/#{rel}", __dir__)
        next unless File.exist?(path)
        contents = File.read(path)
        next if contents.include?('KAKAO_APP_KEY =')
        File.write(path, contents + "\nKAKAO_APP_KEY = #{kakao_app_key}\n")
      end
    end

  end
end
