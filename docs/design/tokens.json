{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Crimp 디자인 토큰 — Variant A (절제됨 · 라임). Claude Design 원본은 docs/design/claude/tokens.jsx 참조. W3C Design Tokens Community Group strict format ($value / $description / $type).",
  "$version": "1.0.0",
  "color": {
    "accent": {
      "base":  { "$value": "#C9F84B", "$type": "color", "$description": "포인트 컬러 — climb-lime" },
      "soft":  { "$value": "#EEFCC1", "$type": "color", "$description": "accent 배경/하이라이트용 연한 변형" },
      "ink":   { "$value": "#0F1419", "$type": "color", "$description": "accent 위 강한 텍스트/아이콘" },
      "flash": { "$value": "#D8FB6E", "$type": "color", "$description": "완등 플래시 애니메이션용" },
      "on":    { "$value": "#0F1419", "$type": "color", "$description": "accent 위 전경 (텍스트·아이콘) — 대비비 4.5+" }
    },
    "neutral": {
      "light": {
        "bg":       { "$value": "#FFFFFF", "$type": "color" },
        "subtle":   { "$value": "#F5F7FA", "$type": "color" },
        "subtle2":  { "$value": "#EEF1F5", "$type": "color" },
        "hairline": { "$value": "#E5E8EB", "$type": "color" },
        "chip":     { "$value": "#F2F4F6", "$type": "color" },
        "text":     { "$value": "#0F1419", "$type": "color" },
        "text2":    { "$value": "#4E5968", "$type": "color" },
        "text3":    { "$value": "#8B95A1", "$type": "color" },
        "text4":    { "$value": "#B0B8C1", "$type": "color" }
      },
      "dark": {
        "bg":       { "$value": "#0D0F12", "$type": "color" },
        "subtle":   { "$value": "#17191C", "$type": "color" },
        "subtle2":  { "$value": "#1E2125", "$type": "color" },
        "hairline": { "$value": "#2A2E33", "$type": "color" },
        "chip":     { "$value": "#1E2125", "$type": "color" },
        "text":     { "$value": "#F7F8F9", "$type": "color" },
        "text2":    { "$value": "#B0B8C1", "$type": "color" },
        "text3":    { "$value": "#8B95A1", "$type": "color" },
        "text4":    { "$value": "#5A6470", "$type": "color" }
      }
    },
    "semantic": {
      "success": { "$value": "#12B886", "$type": "color", "$description": "SEND/ONSIGHT 계열 성공 피드백" },
      "warning": { "$value": "#FAB005", "$type": "color", "$description": "FLASH 하이라이트 · 경고" },
      "danger":  { "$value": "#E03131", "$type": "color", "$description": "파괴적 액션 · 오류" },
      "info":    { "$value": "#C9F84B", "$type": "color", "$description": "정보성 피드백 — accent 재사용" }
    },
    "grade": {
      "$description": "V-scale 난이도별 연속 그라디언트. oklch(L% 0.06 hue) 규칙으로 단일 hue 족에서 명도만 조절.",
      "v0":  { "$value": "oklch(92% 0.06 208)", "$type": "color" },
      "v1":  { "$value": "oklch(85% 0.06 208)", "$type": "color" },
      "v2":  { "$value": "oklch(72% 0.06 210)", "$type": "color" },
      "v3":  { "$value": "oklch(58% 0.06 212)", "$type": "color" },
      "v4":  { "$value": "oklch(45% 0.06 214)", "$type": "color" },
      "v5":  { "$value": "oklch(36% 0.06 216)", "$type": "color" },
      "v6":  { "$value": "oklch(28% 0.06 218)", "$type": "color" },
      "v7":  { "$value": "oklch(22% 0.06 220)", "$type": "color" },
      "v8":  { "$value": "oklch(18% 0.06 222)", "$type": "color" },
      "v9":  { "$value": "oklch(14% 0.06 224)", "$type": "color" },
      "v10": { "$value": "oklch(11% 0.06 226)", "$type": "color" }
    },
    "hold": {
      "$description": "실제 클라이밍 홀드 컬러 10종",
      "red":    { "$value": "#E03131", "$type": "color" },
      "blue":   { "$value": "#1C7ED6", "$type": "color" },
      "yellow": { "$value": "#F59F00", "$type": "color" },
      "green":  { "$value": "#2F9E44", "$type": "color" },
      "white":  { "$value": "#F8F9FA", "$type": "color" },
      "black":  { "$value": "#212529", "$type": "color" },
      "pink":   { "$value": "#E64980", "$type": "color" },
      "orange": { "$value": "#F76707", "$type": "color" },
      "purple": { "$value": "#7048E8", "$type": "color" },
      "gray":   { "$value": "#868E96", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "\"Pretendard Variable\", Pretendard, -apple-system, BlinkMacSystemFont, system-ui, Roboto, \"Helvetica Neue\", \"Segoe UI\", \"Apple SD Gothic Neo\", \"Noto Sans KR\", \"Malgun Gothic\", sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, Consolas, monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" },
      "extrabold":{ "$value": 800, "$type": "fontWeight" }
    },
    "size": {
      "caption": { "$value": "12px", "$type": "dimension" },
      "body":    { "$value": "15px", "$type": "dimension" },
      "title":   { "$value": "18px", "$type": "dimension" },
      "h2":      { "$value": "24px", "$type": "dimension" },
      "h1":      { "$value": "32px", "$type": "dimension" },
      "display": { "$value": "72px", "$type": "dimension" },
      "hero":    { "$value": "120px", "$type": "dimension", "$description": "Variant B 전용 헤드라인. Variant A 에서는 display 사용" }
    },
    "letterSpacing": {
      "caption": { "$value": "0em", "$type": "dimension" },
      "body":    { "$value": "-0.01em", "$type": "dimension" },
      "title":   { "$value": "-0.02em", "$type": "dimension" },
      "h2":      { "$value": "-0.03em", "$type": "dimension" },
      "h1":      { "$value": "-0.04em", "$type": "dimension" },
      "display": { "$value": "-0.05em", "$type": "dimension" },
      "hero":    { "$value": "-0.06em", "$type": "dimension" }
    },
    "lineHeight": {
      "tight":   { "$value": 0.95, "$type": "number" },
      "snug":    { "$value": 1.15, "$type": "number" },
      "normal":  { "$value": 1.5, "$type": "number" },
      "relaxed": { "$value": 1.65, "$type": "number" }
    }
  },
  "space": {
    "0":   { "$value": "0px", "$type": "dimension" },
    "0.5": { "$value": "2px", "$type": "dimension" },
    "1":   { "$value": "4px", "$type": "dimension" },
    "2":   { "$value": "8px", "$type": "dimension" },
    "3":   { "$value": "12px", "$type": "dimension" },
    "4":   { "$value": "16px", "$type": "dimension" },
    "5":   { "$value": "20px", "$type": "dimension" },
    "6":   { "$value": "24px", "$type": "dimension" },
    "8":   { "$value": "32px", "$type": "dimension" },
    "10":  { "$value": "40px", "$type": "dimension" },
    "14":  { "$value": "56px", "$type": "dimension" },
    "20":  { "$value": "80px", "$type": "dimension" }
  },
  "radius": {
    "sm":   { "$value": "8px",    "$type": "dimension" },
    "md":   { "$value": "12px",   "$type": "dimension" },
    "lg":   { "$value": "16px",   "$type": "dimension" },
    "xl":   { "$value": "20px",   "$type": "dimension" },
    "2xl":  { "$value": "28px",   "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "none": { "$value": "none", "$type": "shadow" },
    "xs":   { "$value": "0 1px 2px rgba(15,20,25,0.04), 0 2px 8px rgba(15,20,25,0.04)", "$type": "shadow", "$description": "카드" },
    "sm":   { "$value": "0 4px 16px rgba(15,20,25,0.08)", "$type": "shadow", "$description": "플로팅" },
    "lg":   { "$value": "0 20px 60px rgba(15,20,25,0.18)", "$type": "shadow", "$description": "모달" },
    "dark": {
      "xs": { "$value": "0 1px 2px rgba(0,0,0,0.3), 0 2px 8px rgba(0,0,0,0.2)", "$type": "shadow" },
      "sm": { "$value": "0 4px 16px rgba(0,0,0,0.3)", "$type": "shadow" },
      "lg": { "$value": "0 20px 60px rgba(0,0,0,0.6)", "$type": "shadow" }
    }
  },
  "motion": {
    "duration": {
      "fast":   { "$value": "200ms", "$type": "duration" },
      "normal": { "$value": "300ms", "$type": "duration" },
      "slow":   { "$value": "450ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)", "$type": "cubicBezier", "$description": "기본 ease-out" },
      "spring":   { "$value": "spring(180, 20)", "$type": "other", "$description": "stiffness 180, damping 20 — RN Reanimated / Framer Motion" }
    }
  },
  "touchTarget": {
    "min": { "$value": "44px", "$type": "dimension", "$description": "WCAG AA · iOS HIG 최소 터치 영역" }
  },
  "breakpoint": {
    "sm": { "$value": "640px",  "$type": "dimension" },
    "md": { "$value": "768px",  "$type": "dimension" },
    "lg": { "$value": "1024px", "$type": "dimension" },
    "xl": { "$value": "1280px", "$type": "dimension" }
  },
  "zIndex": {
    "base":     { "$value": 0,  "$type": "number" },
    "dropdown": { "$value": 10, "$type": "number" },
    "sticky":   { "$value": 20, "$type": "number" },
    "overlay":  { "$value": 30, "$type": "number" },
    "modal":    { "$value": 40, "$type": "number" },
    "toast":    { "$value": 50, "$type": "number" }
  }
}
