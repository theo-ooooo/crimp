# Crimp 백엔드 API 베이스 URL (public — 클라이언트 번들에 포함됨)
# 미설정 시 src/lib/api/config.ts 가 http://localhost:8080 을 기본값으로 사용.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Kakao JavaScript SDK 앱키 (public — Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키)
# 미설정 시 `/login` 페이지의 카카오 버튼이 비활성화되고 개발자 모드(직접 id_token 입력)만 노출됨.
# 운영/스테이징 도메인은 카카오 콘솔의 "사이트 도메인" 에 등록되어 있어야 한다.
NEXT_PUBLIC_KAKAO_APP_KEY=your-js-app-key-here

# Kakao Maps JavaScript 키. 보통 NEXT_PUBLIC_KAKAO_APP_KEY 와 같은 JavaScript 키를 넣는다.
# 미설정 시 암장 지도는 fallback 미니맵으로 표시된다.
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=your-js-app-key-here
